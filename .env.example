# Copy to .env and fill in to talk to the real xAI Grok API.
# When XAI_API_KEY is unset, GrokBot runs in deterministic offline mock mode,
# which is what the automated tests and local demos rely on.

# Your xAI API key (https://console.x.ai/)
XAI_API_KEY=

# Optional overrides
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
PORT=3000
